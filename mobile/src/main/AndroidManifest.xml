<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Connect to the serve instance over the LAN + discover it via mDNS/NSD. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- No backup: the app keeps server sign-ins (short-lived grants) in its preferences. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|fontScale|density|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Tapping a `composeai://session?...` link opens straight into the session. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="composeai" android:host="session" />
                <data android:scheme="composeai" android:host="design" />
                <data android:scheme="composeai" android:host="rc" />
            </intent-filter>

            <!--
              The hosted server's design permalinks, catalog previews and uploaded documents open
              straight into a device preview. Host-pinned, so no other web link is claimed.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="preview.coo.ee" />
                <data android:host="ui.coo.ee" />
                <data android:pathPrefix="/ui-builder/" />
                <!-- Uploaded documents (`/d/<id>`) and catalog previews (`/<catalog>/p/<id>`). -->
                <data android:pathPrefix="/d/" />
                <data android:pathPattern="/.*/p/.*" />
            </intent-filter>

            <!--
              Opening a `.rc` document (or a `.uid` design) from a file manager, a download or a
              chat attachment. Neither has a registered MIME type, so they arrive as generic binary
              or JSON; the app tells them apart by name.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <!--
              No host-less http(s) VIEW filter: serve runs on arbitrary LAN hosts, so one would match
              every web URL and hijack unrelated browser links (Android ignores path attributes
              without a host). Other servers' links are pasted into the connect screen, which parses
              every shape via PreviewLink.parse.
            -->
        </activity>
    </application>
</manifest>
